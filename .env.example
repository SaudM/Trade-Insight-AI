# 复制为 .env 并填入真实值。切勿提交含真实密钥的 .env（已被 .gitignore 忽略）。
NODE_ENV=development

# 数据库 / 缓存
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# NextAuth（线上 NEXTAUTH_URL 必须为正式域名）
NEXTAUTH_URL=http://localhost:9002
NEXTAUTH_SECRET=请用 `openssl rand -base64 32` 生成

# 站点地址：密码重置邮件里的链接用它拼接（线上必须为正式域名，如 https://fupan.fulitimes.com）
NEXT_PUBLIC_APP_URL=http://localhost:9002

# 邮件发送 (SMTP，用于密码重置邮件)。SMTP_PASS 为敏感信息，切勿提交真实值
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@fulitimes.com
SMTP_PASS=
SMTP_FROM=Trade Insight <noreply@fulitimes.com>

# AI
GEMINI_API_KEY=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 后端数据服务
HEATMAP_API_URL=http://127.0.0.1:8000

# 微信支付 v3
WX_NOTIFY_URL=https://your-domain/api/subscription/notify
WX_V3_CODE=
WX_SERIAL_NO=
WX_APPID=
WX_MCHID=
# 私钥建议用单引号包裹的单行 PEM
WX_PRIVATE_KEY=

# 微信公众号登录
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_TOKEN=
WECHAT_ORIGINAL_ID=
